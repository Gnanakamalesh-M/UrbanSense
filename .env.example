# Copy to .env and adjust. .env is gitignored and must never hold real secrets;
# this project uses public, sample and synthetic data only (SPEC section 45).
#
# Every value below is a default that already works. Nothing here is required
# to run the project -- the configs under configs/ and the scripts' own flags
# cover the same ground, and this file exists so the overrides are discoverable
# in one place (SPEC section 39).

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

# Which configuration environment to load (configs/base.yaml -> env).
# One of: local | ci
URBANSENSE_ENV=local

# DEBUG | INFO | WARNING | ERROR
URBANSENSE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Data locations
# ---------------------------------------------------------------------------

# Override the data root if your datasets live outside the repo. Whatever this
# points at, data/raw is treated as append-only: never overwritten, never
# deleted. Rejected records go to the quarantine directory instead.
URBANSENSE_DATA_DIR=data
URBANSENSE_QUARANTINE_DIR=quarantine

# ---------------------------------------------------------------------------
# The read-only API (SPEC section 44)
# ---------------------------------------------------------------------------

# There is no authentication on any endpoint, so the default bind is
# localhost-only. Change this only if you understand that it exposes an
# unauthenticated service; scripts/serve_api.py warns when you do.
URBANSENSE_API_HOST=127.0.0.1
URBANSENSE_API_PORT=8000

# ---------------------------------------------------------------------------
# The dashboard (SPEC section 43)
# ---------------------------------------------------------------------------

# Same posture, same reason: no authentication, so localhost by default.
URBANSENSE_DASHBOARD_HOST=127.0.0.1
URBANSENSE_DASHBOARD_PORT=8501

# Where the dashboard reads from. Leave empty to open the stored artifact files
# directly, which needs no server running. Set it to an API base URL to read
# over HTTP instead -- which is what docker-compose does, so the two containers
# exercise the API layer rather than ignoring each other.
#   URBANSENSE_API_URL=http://127.0.0.1:8000
URBANSENSE_API_URL=

# Repository root the dashboard reads artifacts from, when reading files
# directly.
URBANSENSE_ROOT=.
